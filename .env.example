# MongoDB connection string
# For local: mongodb://localhost:27017/hacketon
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/hacketon
MONGODB_URI=mongodb://localhost:27017/hacketon

# JWT secret for token signing (use a strong secret in production)
JWT_SECRET_KEY=your-secret-key-change-in-production

# Gemini API key for icebreaker generation
GEMINI_API_KEY=your-gemini-api-key

# CORS origins (comma-separated for Vue.js frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Test database (optional - defaults to mongodb://localhost:27017/hacketon_test)
# TEST_MONGODB_URI=mongodb://localhost:27017/hacketon_test
